42,"children":411,"markDefs":416,"style":52},"ffd936188908",[412],{"_key":413,"_type":46,"marks":414,"text":415},"621808aba27a",[],"We retain personal information only for as long as necessary to fulfill the purposes for which it was collected, including for the purposes of satisfying any legal, accounting, or reporting requirements. Our retention periods are determined by:",[],{"_key":418,"_type":42,"children":419,"level":98,"listItem":99,"markDefs":424,"style":52},"58bb97632dfd",[420],{"_key":421,"_type":46,"marks":422,"text":423},"5d645de26c40",[],"The amount, nature, and sensitivity of the personal data",[],{"_key":426,"_type":42,"children":427,"level":98,"listItem":99,"markDefs":432,"style":52},"0a2306b6aa14",[428],{"_key":429,"_type":46,"marks":430,"text":431},"f6a10abfc77f",[],"The potential risk of harm from unauthorized use or disclosure",[],{"_key":434,"_type":42,"children":435,"level":98,"listItem":99,"markDefs":440,"style":52},"84ba51255832",[436],{"_key":437,"_type":46,"marks":438,"text":439},"93ecd3024052",[],"The purposes for which we process the personal data",[],{"_key":442,"_type":42,"children":443,"level":98,"listItem":99,"markDefs":448,"style":52},"6692f4b2a1e2",[444],{"_key":445,"_type":46,"marks":446,"text":447},"6d992a31b5f8",[],"Applicable legal requirements",[],{"_key":450,"_type":42,"children":451,"markDefs":456,"style":52},"f7592fe99f8d",[452],{"_key":453,"_type":46,"marks":454,"text":455},"9b3e18b8dc62",[],"Typical retention periods:",[],{"_key":458,"_type":42,"children":459,"level":98,"listItem":99,"markDefs":464,"style":52},"45c16022cf73",[460],{"_key":461,"_type":46,"marks":462,"text":463},"53e4fc276e25",[],"Account information: Retained while account is active plus 3 years",[],{"_key":466,"_type":42,"children":467,"level":98,"listItem":99,"markDefs":472,"style":52},"5effc016deb5",[468],{"_key":469,"_type":46,"marks":470,"text":471},"da06f9bb04e2",[],"Transaction records: 7 years for tax compliance",[],{"_key":474,"_type":42,"children":475,"level":98,"listItem":99,"markDefs":480,"style":52},"7ada8e299aec",[476],{"_key":477,"_type":46,"marks":478,"text":479},"691b35271cfe",[],"Website analytics: 26 months",[],{"_key":482,"_type":42,"children":483,"markDefs":488,"style":69},"b89d6eeb4a12",[484],{"_key":485,"_type":46,"marks":486,"text":487},"d25ffdd7617e",[],"5. Data Security Measures",[],{"_key":490,"_type":42,"children":491,"markDefs":496,"style":52},"9825eeb53ea6",[492],{"_key":493,"_type":46,"marks":494,"text":495},"d52086ceace9",[],"We implement appropriate technical and organizational measures to protect personal information, including:",[],{"_key":498,"_type":42,"children":499,"level":98,"listItem":99,"markDefs":504,"style":52},"603088264a94",[500],{"_key":501,"_type":46,"marks":502,"text":503},"c6f44580f5b7",[],"Encryption of data in transit and at rest",[],{"_key":506,"_type":42,"children":507,"level":98,"listItem":99,"markDefs":512,"style":52},"cd38f1fdd8fc",[508],{"_key":509,"_type":46,"marks":510,"text":511},"d09bc14e26f6",[],"Regular security assessments and penetration testing",[],{"_key":514,"_type":42,"children":515,"level":98,"listItem":99,"markDefs":520,"style":52},"8673f7c491ea",[516],{"_key":517,"_type":46,"marks":518,"text":519},"98eb97ba72f5",[],"Access controls and least privilege principles",[],{"_key":522,"_type":42,"children":523,"level":98,"listItem":99,"markDefs":528,"style":52},"5a3fa6136445",[524],{"_key":525,"_type":46,"marks":526,"text":527},"12a53ed46b20",[],"Employee security training and awareness programs",[],{"_key":530,"_type":42,"children":531,"level":98,"listItem":99,"markDefs":536,"style":52},"88311c463855",[532],{"_key":533,"_type":46,"marks":534,"text":535},"f535543ad0cc",[],"Incident response and breach notification procedures",[],{"_key":538,"_type":42,"children":539,"markDefs":544,"style":52},"5b3805ba4c0e",[540],{"_key":541,"_type":46,"marks":542,"text":543},"bb98574e8da7",[],"While we strive to protect your personal information, no security system is 